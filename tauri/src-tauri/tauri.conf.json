{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Simple counter template for applications in Elm + Tauri + Crux.",
  "version": "0.1.0",
  "identifier": "xyz.funzen.elm-tauri-crux",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "beforeBuildCommand": "pnpm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist",
    "removeUnusedCommands": true
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Elm ❤️ Tauri 🎉 Crux",
        "center": true,
        "fullscreen": false,
        "resizable": true,
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
